---
import AppShell from '../layouts/AppShell.astro';
---

<AppShell>
	<Fragment slot="source-panel">
		<section class="sidebar-section">
			<h2>Device</h2>
			<div id="toolbar">
				<button id="connect">Connect device</button>
			</div>
			<label for="device-storage">Storage</label>
			<select id="device-storage" disabled>
				<option value="">Connect a device to choose storage</option>
			</select>
			<div id="crumbs"></div>
			<div id="status">Click "Connect device" to get started.</div>
			<label for="device-upload">Upload to this folder</label>
			<input id="device-upload" type="file" disabled />
			<div id="listing"></div>
		</section>

		<section class="sidebar-section">
			<h2>Upload</h2>
			<p class="panel-note">
				Can't connect a device? (Safari and some other browsers don't support WebUSB.) Upload a
				<code>.note</code> file directly instead.
			</p>
			<input id="upload-note" type="file" accept=".note" />
			<p id="upload-status" class="panel-note"></p>
		</section>
	</Fragment>

	<script src="../scripts/device-browser.ts"></script>
	<script src="../scripts/upload-note.ts"></script>
</AppShell>
