---
import '../styles/global.css';
import { DEFAULT_PROMPT } from '../lib/tpx/inference';
import { NOAI_STORAGE_KEY } from '../lib/noai';

export interface Props {
  title?: string;
}

const { title = 'Supernote USB MTP Viewer and AI Handwriting to Text' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<link rel="icon" href={`${base}favicon.ico`} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script is:inline define:vars={{ key: NOAI_STORAGE_KEY }}>
			if (localStorage.getItem(key) === '1') {
				document.documentElement.classList.add('noai');
			}
		</script>
		<script type="module" src={`${base}vendor/supernote-viewer.js`} is:inline></script>
	</head>
	<body>
		<div id="topbar">
			<button id="menu-toggle" aria-label="Toggle file browser" aria-expanded="true" aria-controls="sidebar">☰</button>
			<h1>{title}</h1>
		</div>

		<div id="app">
			<aside id="sidebar">
				<div id="sidebar-tabs" role="tablist">
					<button id="tab-browse" class="sidebar-tab" role="tab" aria-selected="true" aria-controls="browse-panel">Browse</button>
					<button id="tab-convert" class="sidebar-tab" role="tab" aria-selected="false" aria-controls="convert-panel">Convert</button>
					<button id="tab-settings" class="sidebar-tab" role="tab" aria-selected="false" aria-controls="settings-panel">Settings</button>
				</div>

				<div id="browse-panel" class="sidebar-panel" role="tabpanel">
					<slot name="source-panel" />
				</div>

				<div id="convert-panel" class="sidebar-panel" role="tabpanel" hidden>
					<section class="sidebar-section ai-only">
						<h2>AI Recognition</h2>
						<button id="run-ocr" disabled>Convert Handwriting to Text with AI</button>
						<p id="ocr-status"></p>
						<button id="download-txt" hidden>Download .txt</button>
						<button id="download-pdf-ai" hidden>Download as PDF (AI Text)</button>
					</section>

					<section class="sidebar-section">
						<h2>Export</h2>
						<button id="download-page-png" disabled>Download Current Page as PNG</button>
						<p id="page-png-status"></p>
						<button id="download-pdf" disabled>Download as PDF</button>
						<p id="pdf-status"></p>
						<button id="download-note" disabled>Download .note</button>
					</section>
				</div>

				<div id="settings-panel" class="sidebar-panel" role="tabpanel" hidden>
					<section id="tpx-panel" class="sidebar-section">
						<h2>TPX</h2>
						<p class="panel-note">
							Use our AI below OR <a href="https://tokenpony.dev/#local" target="_blank" rel="noopener noreferrer">bring your own AI</a>
						</p>
						<label for="tpx-provider">Provider</label>
						<input id="tpx-provider" type="url" value="https://api.tokenpony.dev" />
						<label for="tpx-budget">Budget (USD)</label>
						<input id="tpx-budget" type="number" min="0.01" step="0.01" value="0.10" />
						<button id="tpx-connect">Connect TPX</button>
						<button id="tpx-disconnect" hidden>Disconnect</button>
						<p id="tpx-status">Not connected.</p>

						<label for="tpx-model">Model</label>
						<select id="tpx-model" disabled>
							<option value="">Connect to see available models</option>
						</select>

						<details class="prompt-details">
							<summary>Recognition prompt</summary>
							<textarea id="tpx-prompt" rows="6">{DEFAULT_PROMPT}</textarea>
						</details>
					</section>
				</div>
			</aside>

			<div id="sidebar-backdrop" hidden></div>

			<main id="viewer-pane">
				<div id="viewer-body">
					<p id="empty-state">Select a <code>.note</code> file from the menu to preview it here.</p>
					<supernote-viewer id="viewer" invert-dark hidden></supernote-viewer>
					<div id="ocr-result" class="ai-only" hidden>
						<pre id="ocr-text"></pre>
					</div>
				</div>
			</main>
		</div>

		<footer id="app-footer">
			<a href="https://github.com/philips/supernote-tpx-ocr" target="_blank" rel="noopener noreferrer">Source on GitHub</a>
			<span aria-hidden="true">·</span>
			<a href="https://github.com/philips/supernote-tpx-ocr/blob/main/LICENSE" target="_blank" rel="noopener noreferrer">AGPL-3.0-or-later</a>
			<span aria-hidden="true">·</span>
			<a id="noai-link" href={`${base}noai/`}>No AI / TPX-free mode</a>
		</footer>

		<dialog id="welcome-dialog">
			<h2>Supernote USB MTP Viewer and AI Handwriting to Text</h2>
			<p>
				Recognize handwriting from your Supernote <code>.note</code> files, entirely in your
				browser - no app to install, no server of ours in the middle.
			</p>
			<ol>
				<li>Connect your Supernote over USB, or upload a <code>.note</code> file directly.</li>
				<li>Connect a TPX provider (tokenpony.dev, or one you self-host) to bring your own LLM budget.</li>
				<li>Run recognition and download the result as text.</li>
			</ol>
			<p class="panel-note">
				Everything runs client-side - your notes and TPX grant go straight to your device and your
				chosen provider, never through a server we run.
			</p>
			<button id="welcome-dismiss">Got it</button>
		</dialog>

		<script src="../scripts/sidebar-toggle.ts"></script>
		<script src="../scripts/sidebar-tabs.ts"></script>
		<script src="../scripts/noai.ts"></script>
		<script src="../scripts/tpx-login.ts"></script>
		<script src="../scripts/welcome.ts"></script>
		<slot />
		<script src="../scripts/export-png.ts"></script>
		<script src="../scripts/export-pdf.ts"></script>
		<script src="../scripts/export-note.ts"></script>
		<script src="../scripts/ocr.ts"></script>
	</body>
</html>
